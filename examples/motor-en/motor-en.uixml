<?xml version='1.0' encoding='utf-8'?>
<ui>
  <project name="motor" width="1024" height="600" font="demo_16" />
  <var name="led_run" type="integer" default="255" />
  <var name="led_can" type="integer" default="255" />
  <var name="led_rs" type="integer" default="120" />
  <var name="rtc" type="string" default="2026-08-18 14:30" />
  <var name="speed" type="integer" default="1350" />
  <var name="torque" type="integer" default="42" />
  <var name="power" type="integer" default="6" />
  <var name="eff" type="integer" default="94" />
  <var name="motor_temp" type="integer" default="62" />
  <var name="bus_volt" type="integer" default="540" />
  <var name="out_curr" type="integer" default="12" />
  <var name="fwd_on" type="boolean" default="true" />
  <var name="eco_on" type="boolean" default="false" />
  <widget width="1024" height="36" bg="#151B28" name="StatusBar">
    <label text="MotorDrive MD-200" font="demo_20" color="#2E86DE" x="12" y="7" w="180" h="22" />
    <led color="#27AE60" bind="led_run" x="210" y="14" w="8" h="8" />
    <label text="RUN" color="#7A8499" x="222" y="10" w="36" h="16" />
    <led color="#27AE60" bind="led_can" x="268" y="14" w="8" h="8" />
    <label text="CAN" color="#7A8499" x="280" y="10" w="40" h="16" />
    <led color="#F6B93B" bind="led_rs" x="330" y="14" w="8" h="8" />
    <label text="RS485" color="#7A8499" x="342" y="10" w="50" h="16" />
    <label text="Output: 45.2 Hz" color="#E0E4EA" x="700" y="10" w="100" h="16" />
    <label bind="rtc" preview="2026-08-18 14:30" color="#E0E4EA" x="830" y="10" w="170" h="16" />
  </widget>
  <screen name="overview">
    <instance widget="StatusBar" x="0" y="0" />
    <panel x="0" y="36" w="88" h="564" bg="#151B28">
      <button text="&#10;Overview" x="6" y="6" w="76" h="52" color="#2E86DE" bg="#1B2C42" radius="8" on-clicked="nav_overview" />
      <button text="&#10;Params" x="6" y="68" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_params" />
      <button text="&#10;Alarms" x="6" y="130" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_alarms" />
      <panel x="0" y="6" w="4" h="52" bg="#2E86DE" />
      <line x="87" y="0" dir="v" h="564" />
    </panel>
    <panel id="metrics_row" x="96" y="44" w="920" h="80" bg="#0A0E14">
      <panel id="card_speed" x="0" y="0" w="221" h="80" bg="#1C2333" radius="8">
        <label text="Speed" color="#7A8499" x="12" y="8" w="120" h="16" />
        <label bind="speed" preview="1350" color="#0ABDE3" font="demo_20" x="12" y="30" w="150" h="30" id="val_speed" />
        <label text="RPM" color="#7A8499" x="12" y="58" w="50" h="14" />
      </panel>
      <panel id="card_torque" x="233" y="0" w="221" h="80" bg="#1C2333" radius="8">
        <label text="Torque" color="#7A8499" x="12" y="8" w="130" h="16" />
        <label bind="torque" preview="42.5" color="#0ABDE3" font="demo_20" x="12" y="30" w="150" h="30" id="val_torque" />
        <label text="N·m" color="#7A8499" x="12" y="58" w="50" h="14" />
      </panel>
      <panel id="card_power" x="466" y="0" w="221" h="80" bg="#1C2333" radius="8">
        <label text="Power" color="#7A8499" x="12" y="8" w="120" h="16" />
        <label bind="power" preview="6.2" color="#0ABDE3" font="demo_20" x="12" y="30" w="150" h="30" id="val_power" />
        <label text="kW" color="#7A8499" x="12" y="58" w="50" h="14" />
      </panel>
      <panel id="card_eff" x="699" y="0" w="221" h="80" bg="#1C2333" radius="8">
        <label text="Efficiency" color="#7A8499" x="12" y="8" w="150" h="16" />
        <label bind="eff" preview="94.8" color="#0ABDE3" font="demo_20" x="12" y="30" w="150" h="30" id="val_eff" />
        <label text="%" color="#7A8499" x="12" y="58" w="30" h="14" />
      </panel>
    </panel>
    <panel id="gauge_row" x="96" y="136" w="920" h="240" bg="#0A0E14">
      <panel id="gauge_temp" x="0" y="0" w="298" h="240" bg="#151B28" radius="8">
        <label text="Motor Temp" color="#7A8499" x="89" y="8" w="120" h="16" align="center" />
        <arc bind="motor_temp" min="0" max="150" x="79" y="40" w="140" h="140" bgStartAngle="135" bgEndAngle="45" on-value_changed="on_motor_temp" />
        <label bind="motor_temp" preview="62" color="#F6B93B" font="demo_20" x="109" y="90" w="80" h="28" align="center" />
        <label text="°C" color="#7A8499" x="129" y="118" w="40" h="16" align="center" />
      </panel>
      <panel id="gauge_volt" x="311" y="0" w="298" h="240" bg="#151B28" radius="8">
        <label text="Bus Voltage" color="#7A8499" x="84" y="8" w="131" h="16" align="center" />
        <arc bind="bus_volt" min="0" max="900" x="79" y="40" w="140" h="140" bgStartAngle="135" bgEndAngle="45" on-value_changed="on_bus_volt" />
        <label bind="bus_volt" preview="540" color="#2E86DE" font="demo_20" x="99" y="90" w="100" h="28" align="center" />
        <label text="V DC" color="#7A8499" x="119" y="118" w="60" h="16" align="center" />
      </panel>
      <panel id="gauge_curr" x="622" y="0" w="298" h="240" bg="#151B28" radius="8">
        <label text="Output Current" color="#7A8499" x="68" y="8" w="162" h="16" align="center" />
        <arc bind="out_curr" min="0" max="30" x="79" y="40" w="140" h="140" bgStartAngle="135" bgEndAngle="45" on-value_changed="on_out_curr" />
        <label bind="out_curr" preview="12.8" color="#2E86DE" font="demo_20" x="99" y="90" w="100" h="28" align="center" />
        <label text="A" color="#7A8499" x="134" y="118" w="30" h="16" align="center" />
      </panel>
    </panel>
    <panel id="ctrl_row" x="96" y="388" w="920" h="204" bg="#0A0E14">
      <panel id="ctrl_speed" x="0" y="0" w="454" h="204" bg="#151B28" radius="8">
        <label text="Speed Control" color="#7A8499" x="12" y="8" w="132" h="16" />
        <line x="12" y="28" w="430" />
        <label text="Target" color="#7A8499" x="12" y="44" w="66" h="16" />
        <slider bind="speed" min="0" max="3000" x="84" y="46" w="252" h="18" on-value_changed="on_speed" />
        <label bind="speed" preview="1350" color="#0ABDE3" x="348" y="44" w="60" h="16" id="sl_speed" />
        <label text="Accel" color="#7A8499" x="12" y="80" w="62" h="16" />
        <slider bind="torque" min="1" max="30" x="84" y="82" w="252" h="18" on-value_changed="on_torque" />
        <label text="5.0s" color="#0ABDE3" x="348" y="80" w="50" h="16" />
      </panel>
      <panel id="ctrl_run" x="466" y="0" w="454" h="204" bg="#151B28" radius="8">
        <label text="Run Control" color="#7A8499" x="12" y="8" w="116" h="16" />
        <line x="12" y="28" w="430" />
        <label text="Forward" color="#7A8499" x="12" y="50" w="76" h="16" />
        <switch bind="fwd_on" x="92" y="46" w="50" h="24" on-value_changed="on_fwd" />
        <label text="Running" color="#27AE60" x="150" y="50" w="76" h="16" />
        <label text="ECO" color="#7A8499" x="12" y="90" w="50" h="16" />
        <switch bind="eco_on" x="92" y="86" w="50" h="24" on-value_changed="on_eco" />
        <label text="Off" color="#7A8499" x="150" y="90" w="50" h="16" />
      </panel>
    </panel>
  </screen>
  <screen name="params">
    <instance widget="StatusBar" x="0" y="0" />
    <panel x="0" y="36" w="88" h="564" bg="#151B28">
      <button text="&#10;Overview" x="6" y="6" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_overview" />
      <button text="&#10;Params" x="6" y="68" w="76" h="52" color="#2E86DE" bg="#1B2C42" radius="8" on-clicked="nav_params" />
      <button text="&#10;Alarms" x="6" y="130" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_alarms" />
      <panel x="0" y="68" w="4" h="52" bg="#2E86DE" />
      <line x="87" y="0" dir="v" h="564" />
    </panel>
    <panel x="96" y="44" w="302" h="548" bg="#151B28" radius="8">
      <label text="Motor" color="#2E86DE" x="12" y="10" w="200" h="16" />
      <line x="12" y="32" w="272" />
      <label text="Rated power" color="#7A8499" x="12" y="46" w="114" h="16" />
      <label text="7.5 kW" x="134" y="46" w="80" h="16" />
      <label text="Rated volt" color="#7A8499" x="12" y="72" w="114" h="16" />
      <label text="380 V AC" x="134" y="72" w="90" h="16" />
      <label text="Rated curr" color="#7A8499" x="12" y="98" w="114" h="16" />
      <label text="16.5 A" x="134" y="98" w="70" h="16" />
      <label text="Poles" color="#7A8499" x="12" y="124" w="114" h="16" />
      <dropdown selected="0" x="134" y="120" w="100" h="26" id="dd_poles" on-value_changed="on_poles" options="4P,2P,6P" />
      <label text="Ctrl mode" color="#7A8499" x="12" y="156" w="114" h="16" />
      <dropdown selected="0" x="134" y="152" w="120" h="26" id="dd_ctrl_mode" on-value_changed="on_ctrl_mode" options="V/F,Vector,Servo" />
      <label text="Carrier freq" color="#7A8499" x="12" y="190" w="114" h="16" />
      <slider bind="torque" min="2" max="16" x="134" y="192" w="104" h="18" on-value_changed="on_torque" />
      <label text="8 kHz" color="#0ABDE3" x="244" y="190" w="46" h="16" />
    </panel>
    <panel x="408" y="44" w="302" h="548" bg="#151B28" radius="8">
      <label text="Protection" color="#2E86DE" x="12" y="10" w="220" h="16" />
      <line x="12" y="32" w="272" />
      <label text="Overcurrent" color="#7A8499" x="12" y="46" w="114" h="16" />
      <slider bind="motor_temp" min="50" max="200" x="134" y="48" w="104" h="18" on-value_changed="on_motor_temp" />
      <label text="150%" color="#0ABDE3" x="242" y="46" w="48" h="16" />
      <label text="Overvoltage" color="#7A8499" x="12" y="80" w="114" h="16" />
      <slider bind="bus_volt" min="600" max="900" x="134" y="82" w="104" h="18" on-value_changed="on_bus_volt" />
      <label text="800V" color="#0ABDE3" x="242" y="80" w="48" h="16" />
      <label text="Overtemp" color="#7A8499" x="12" y="114" w="114" h="16" />
      <slider bind="motor_temp" min="60" max="120" x="134" y="116" w="104" h="18" on-value_changed="on_motor_temp" />
      <label text="90°C" color="#0ABDE3" x="242" y="114" w="48" h="16" />
      <label text="Stall" color="#7A8499" x="12" y="150" w="114" h="16" />
      <switch bind="fwd_on" x="134" y="146" w="50" h="24" on-value_changed="on_fwd" />
      <label text="Phase loss" color="#7A8499" x="12" y="186" w="114" h="16" />
      <switch bind="eco_on" x="134" y="182" w="50" h="24" on-value_changed="on_eco" />
    </panel>
    <panel x="720" y="44" w="302" h="548" bg="#151B28" radius="8">
      <label text="Communication" color="#2E86DE" x="12" y="10" w="220" h="16" />
      <line x="12" y="32" w="272" />
      <label text="CAN Baudrate" color="#7A8499" x="12" y="46" w="114" h="16" />
      <dropdown selected="1" x="134" y="42" w="90" h="26" id="dd_can_baud" on-value_changed="on_can_baud" options="250K,500K,1M" />
      <label text="CAN Node" color="#7A8499" x="12" y="78" w="114" h="16" />
      <slider bind="out_curr" min="1" max="127" x="134" y="80" w="92" h="18" on-value_changed="on_out_curr" />
      <label text="Node 3" color="#0ABDE3" x="232" y="78" w="58" h="16" />
      <label text="RS485" color="#7A8499" x="12" y="110" w="114" h="16" />
      <dropdown selected="0" x="134" y="106" w="140" h="26" id="dd_protocol" on-value_changed="on_protocol" options="Modbus RTU,Custom" />
      <label text="Heartbeat" color="#7A8499" x="12" y="146" w="114" h="16" />
      <slider bind="speed" min="100" max="5000" x="134" y="148" w="92" h="18" on-value_changed="on_speed" />
      <label text="1.0s" color="#0ABDE3" x="232" y="146" w="48" h="16" />
    </panel>
  </screen>
  <screen name="alarms">
    <instance widget="StatusBar" x="0" y="0" />
    <panel x="0" y="36" w="88" h="564" bg="#151B28">
      <button text="&#10;Overview" x="6" y="6" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_overview" />
      <button text="&#10;Params" x="6" y="68" w="76" h="52" color="#7A8499" bg="#151B28" radius="8" on-clicked="nav_params" />
      <button text="&#10;Alarms" x="6" y="130" w="76" h="52" color="#2E86DE" bg="#1B2C42" radius="8" on-clicked="nav_alarms" />
      <panel x="0" y="130" w="4" h="52" bg="#2E86DE" />
      <line x="87" y="0" dir="v" h="564" />
    </panel>
    <panel x="96" y="44" w="296" h="56" bg="#1C2333" radius="6">
      <led color="#E74C3C" x="12" y="24" w="8" h="8" />
      <label text="2" color="#E74C3C" font="demo_20" x="28" y="14" w="40" h="28" />
      <label text="Critical" color="#7A8499" x="80" y="20" w="80" h="16" />
    </panel>
    <panel x="404" y="44" w="296" h="56" bg="#1C2333" radius="6">
      <led color="#F6B93B" x="12" y="24" w="8" h="8" />
      <label text="3" color="#F6B93B" font="demo_20" x="28" y="14" w="40" h="28" />
      <label text="Warning" color="#7A8499" x="80" y="20" w="72" h="16" />
    </panel>
    <panel x="712" y="44" w="296" h="56" bg="#1C2333" radius="6">
      <led color="#27AE60" x="12" y="24" w="8" h="8" />
      <label text="12" color="#27AE60" font="demo_20" x="28" y="14" w="50" h="28" />
      <label text="Normal" color="#7A8499" x="90" y="20" w="62" h="16" />
    </panel>
    <panel x="96" y="112" w="900" h="480" bg="#151B28" radius="8" scrollable="true">
      <label text="Time" color="#7A8499" x="40" y="8" w="70" h="14" />
      <label text="Description" color="#7A8499" x="120" y="8" w="110" h="14" />
      <label text="Action" color="#7A8499" x="826" y="8" w="60" h="14" />
      <line x="10" y="26" w="880" />
      <panel x="10" y="34" w="880" h="40" bg="#1C2333" radius="4">
        <led color="#E74C3C" x="10" y="16" w="8" h="8" />
        <label text="14:22:15" color="#7A8499" x="30" y="12" w="80" h="16" />
        <label text="Motor overcurrent 152% (limit 150%)" x="110" y="12" w="340" h="16" />
        <button text="ACK" x="796" y="8" w="70" h="24" on-clicked="ack_alarm" />
      </panel>
      <panel x="10" y="82" w="880" h="40" bg="#1C2333" radius="4">
        <led color="#E74C3C" x="10" y="16" w="8" h="8" />
        <label text="13:05:42" color="#7A8499" x="30" y="12" w="80" h="16" />
        <label text="Bus overvolt 815V (limit 800V)" x="110" y="12" w="340" h="16" />
        <button text="ACK" x="796" y="8" w="70" h="24" on-clicked="ack_alarm" />
      </panel>
      <panel x="10" y="130" w="880" h="40" bg="#1C2333" radius="4">
        <led color="#F6B93B" x="10" y="16" w="8" h="8" />
        <label text="12:30:18" color="#7A8499" x="30" y="12" w="80" h="16" />
        <label text="Motor temp high 85°C" x="110" y="12" w="250" h="16" />
        <button text="ACK" x="796" y="8" w="70" h="24" on-clicked="ack_alarm" />
      </panel>
      <panel x="10" y="178" w="880" h="40" bg="#1C2333" radius="4">
        <led color="#F6B93B" x="10" y="16" w="8" h="8" />
        <label text="11:15:33" color="#7A8499" x="30" y="12" w="80" h="16" />
        <label text="CAN latency 15 ms" x="110" y="12" w="250" h="16" />
        <button text="ACK" x="796" y="8" w="70" h="24" on-clicked="ack_alarm" />
      </panel>
      <panel x="10" y="226" w="880" h="40" bg="#1C2333" radius="4">
        <led color="#F6B93B" x="10" y="16" w="8" h="8" />
        <label text="09:00:07" color="#7A8499" x="30" y="12" w="80" h="16" />
        <label text="RS485 offline" x="110" y="12" w="200" h="16" />
        <button text="ACK" x="796" y="8" w="70" h="24" on-clicked="ack_alarm" />
      </panel>
    </panel>
  </screen>
  <action name="nav_overview">
    <change-screen screen="overview" />
  </action>
  <action name="nav_params">
    <change-screen screen="params" />
  </action>
  <action name="nav_alarms">
    <change-screen screen="alarms" />
  </action>
  <action name="on_speed" />
  <action name="on_torque" />
  <action name="on_motor_temp" />
  <action name="on_bus_volt" />
  <action name="on_out_curr" />
  <action name="on_fwd" />
  <action name="on_eco" />
  <action name="on_poles" />
  <action name="on_ctrl_mode" />
  <action name="on_can_baud" />
  <action name="on_protocol" />
  <action name="ack_alarm" />
</ui>