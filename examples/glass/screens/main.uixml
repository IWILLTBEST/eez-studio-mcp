<?xml version='1.0' encoding='utf-8'?>
<ui xmlns:lv="urn:eez:lv">
  <screen name="main">
    <panel id="bg" x="0" y="0" w="1024" h="600" bg="#0E1524" radius="0" lv:bg-grad-color="#05080F" lv:bg-grad-dir="VER" lv:bg-main-stop="60" lv:bg-grad-stop="255">
      <label id="title" x="28" y="22" w="420" h="30" text="Glass Dashboard" font="demo_20" />
      <label id="subtitle" x="28" y="54" w="460" h="18" text="glassmorphism + entrance animation showcase" color="#5A6A86" font="demo_16" />
      <panel x="24" y="84" w="233" h="148" bg="#1B2436" bgOpa="150" radius="16" id="card_speed" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="icon_speed" x="18" y="16" w="30" h="24" text="" color="#5EE6C4" font="demo_16" />
        <label id="title_speed" x="56" y="18" w="160" h="20" text="Speed" color="#8FA0BC" font="demo_16" />
        <label id="val_speed" bind="speed" x="18" y="52" w="140" h="34" font="demo_20" align="left" />
        <label id="unit_speed" x="160" y="62" w="55" h="20" text="RPM" color="#8FA0BC" font="demo_16" />
      </panel>
      <panel x="269" y="84" w="233" h="148" bg="#1B2436" bgOpa="150" radius="16" id="card_temp" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="icon_temp" x="18" y="16" w="30" h="24" text="" color="#5EE6C4" font="demo_16" />
        <label id="title_temp" x="56" y="18" w="160" h="20" text="Core Temp" color="#8FA0BC" font="demo_16" />
        <label id="val_temp" bind="temp" x="18" y="52" w="140" h="34" font="demo_20" align="left" />
        <label id="unit_temp" x="160" y="62" w="55" h="20" text="°C" color="#8FA0BC" font="demo_16" />
      </panel>
      <panel x="514" y="84" w="233" h="148" bg="#1B2436" bgOpa="150" radius="16" id="card_volt" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="icon_volt" x="18" y="16" w="30" h="24" text="" color="#5EE6C4" font="demo_16" />
        <label id="title_volt" x="56" y="18" w="160" h="20" text="Bus Voltage" color="#8FA0BC" font="demo_16" />
        <label id="val_volt" bind="volt" x="18" y="52" w="140" h="34" font="demo_20" align="left" />
        <label id="unit_volt" x="160" y="62" w="55" h="20" text="V" color="#8FA0BC" font="demo_16" />
      </panel>
      <panel x="759" y="84" w="233" h="148" bg="#1B2436" bgOpa="150" radius="16" id="card_curr" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="icon_curr" x="18" y="16" w="30" h="24" text="" color="#5EE6C4" font="demo_16" />
        <label id="title_curr" x="56" y="18" w="160" h="20" text="Output Current" color="#8FA0BC" font="demo_16" />
        <label id="val_curr" bind="curr" x="18" y="52" w="140" h="34" font="demo_20" align="left" />
        <label id="unit_curr" x="160" y="62" w="55" h="20" text="A" color="#8FA0BC" font="demo_16" />
      </panel>
      <panel id="panel_gauge" x="24" y="248" w="600" h="328" bg="#1B2436" bgOpa="150" radius="16" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="gauge_title" x="24" y="18" w="240" h="20" text="MOTOR OUTPUT" color="#8FA0BC" font="demo_16" />
        <arc id="arc_power" bind="power" x="200" y="52" w="200" h="200" min="0" max="100" color="#5EE6C4" />
        <label id="val_power" bind="power" x="250" y="120" w="100" h="32" font="demo_20" align="center" />
        <label id="unit_power" x="250" y="156" w="100" h="18" text="%" color="#8FA0BC" font="demo_16" align="center" />
        <label id="gauge_hint" x="24" y="284" w="380" h="18" text="Long animations, glass cards, staggered entrance" color="#5A6A86" font="demo_16" />
      </panel>
      <panel id="panel_status" x="636" y="248" w="364" h="168" bg="#1B2436" bgOpa="150" radius="16" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="status_title" x="20" y="16" w="200" h="20" text="SYSTEM STATUS" color="#8FA0BC" font="demo_16" />
        <led id="led_heart" bind="heartbeat" x="24" y="52" w="12" h="12" color="#5EE6C4" />
        <label id="lbl_heart" x="48" y="48" w="200" h="20" text="Communication" color="#C7D3E8" font="demo_16" />
        <led id="led_warn" bind="warning" x="24" y="84" w="12" h="12" color="#F0B24A" />
        <label id="lbl_warn" x="48" y="80" w="200" h="20" text="Warnings" color="#C7D3E8" font="demo_16" />
        <led id="led_err" bind="fault" x="24" y="116" w="12" h="12" color="#E8695E" />
        <label id="lbl_err" x="48" y="112" w="200" h="20" text="Faults" color="#C7D3E8" font="demo_16" />
        <label id="lbl_breath" x="220" y="112" w="130" h="20" text="breathing -&gt;" color="#5A6A86" font="demo_16" />
      </panel>
      <panel id="panel_action" x="636" y="428" w="364" h="148" bg="#1B2436" bgOpa="150" radius="16" lv:border-width="1" lv:border-color="#9FB2D8" lv:border-opa="40" lv:shadow-width="26" lv:shadow-spread="3" lv:shadow-color="#000000" lv:shadow-opa="130">
        <label id="action_title" x="20" y="16" w="220" h="20" text="ENTRANCE" color="#8FA0BC" font="demo_16" />
        <button id="replay" x="20" y="52" w="150" h="72" text="&#10;Replay" radius="14" bg="#22D3A5" bgOpa="220" on-clicked="entrance" lv:shadow-width="18" lv:shadow-spread="2" lv:shadow-color="#22D3A5" lv:shadow-opa="90">
          <state name="PRESSED" bg="#2AF0BE" />
        </button>
        <label id="action_hint" x="190" y="60" w="160" h="60" text="Staggered slide + fade, 420ms, ease_out" color="#5A6A86" font="demo_16" />
      </panel>
    </panel>
  </screen>
</ui>