<?xml version='1.0' encoding='utf-8'?>
<ui>
  <project name="richdata-demo" width="480" height="640" font="demo_16" />
  <var name="mode_idx" type="integer" default="1" />
  <var name="pulse_count" type="integer" default="42" />
  <screen name="main">
    <panel id="root" x="0" y="0" w="480" h="640" bg="#101828">
      <label id="title" x="24" y="20" w="300" h="24" text="Rich Data Demo" font="demo_20" color="#E8EFFA" />
      <label id="lbl_mode" x="24" y="64" w="200" h="18" text="Control mode (roller)" color="#8FA0BC" />
      <roller id="mode" bind="mode_idx" x="24" y="90" w="170" h="92" bg="#1A2438" on-value_changed="on_mode_change" options="Auto,Manual,Service,Bootstrap" />
      <label id="lbl_chart" x="24" y="200" w="300" h="18" text="Bus current (chart)" color="#8FA0BC" />
      <chart id="bus" kind="line" min="0" max="400" points="120" x="24" y="226" w="432" h="160" bg="#0B1220">
        <series name="Ibus" color="#5EE6C4" width="2" />
        <series name="Limit" color="#F2B84B" width="1" />
      </chart>
      <label id="lbl_tbl" x="24" y="404" w="300" h="18" text="Event log (table)" color="#8FA0BC" />
      <table id="events" cols="3" rows="5" x="24" y="430" w="432" h="150" bg="#0B1220" header="Time,Code,Message" />
      <label id="hint" x="24" y="600" w="432" h="18" text="chart/table structure: runtime C via ui_ext.h" color="#5A6A86" />
    </panel>
  </screen>
  <screen name="controls">
    <panel id="root2" x="0" y="0" w="480" h="640" bg="#101828">
      <label id="title2" x="24" y="16" w="300" h="24" text="Controls Demo" font="demo_20" color="#E8EFFA" />
      <label id="lbl_scale" x="24" y="52" w="200" h="18" text="RPM scale" color="#8FA0BC" />
      <scale id="rpm" mode="round_inner" min="0" max="3000" angle="270" rotate="135" ticks="11" major="5" x="24" y="74" w="180" h="180">
        <section from="0" to="2200" color="#3A4B66" width="8" />
        <section from="2200" to="2600" color="#F2B84B" width="8" />
        <section from="2600" to="3000" color="#E5484D" width="8" />
      </scale>
      <calendar id="cal" today="2026-09-01" x="240" y="74" w="210" h="210" header="arrow" />
      <label id="lbl_count" x="24" y="286" w="200" h="18" text="Pulse count" color="#8FA0BC" />
      <spinbox id="count" bind="pulse_count" min="0" max="9999" digits="4" x="24" y="308" w="130" h="46" bg="#1A2438" />
      <textarea id="input" text="" x="24" y="374" w="432" h="44" bg="#0B1220" />
      <keyboard id="kb" textarea="input" mode="number" x="24" y="426" w="432" h="190" />
    </panel>
  </screen>
  <screen name="settings">
    <panel id="root3" x="0" y="0" w="480" h="640" bg="#101828">
      <tabview id="cfg" bind="mode_idx" position="top" barSize="44" x="16" y="16" w="448" h="420" on-value_changed="on_mode_change">
        <tab title="Display">
          <label id="t1a" x="16" y="16" w="200" h="20" text="Brightness" color="#8FA0BC" />
          <slider id="bright" x="16" y="44" w="320" h="12" />
          <label id="t1b" x="16" y="76" w="200" h="20" text="Theme: Dark" color="#5EE6C4" />
        </tab>
        <tab title="Network">
          <label id="t2a" x="16" y="16" w="300" h="20" text="Host: 192.168.1.10" color="#8FA0BC" />
          <label id="t2b" x="16" y="44" w="300" h="20" text="Port: 502" color="#8FA0BC" />
          <switch id="dhcp" x="340" y="12" w="50" h="25" />
        </tab>
      </tabview>
    </panel>
  </screen>
  <action name="on_mode_change">
    <set variable="mode_idx" value="mode_idx" />
  </action>
</ui>