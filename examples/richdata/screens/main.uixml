<?xml version='1.0' encoding='utf-8'?>
<ui>
  <screen name="main">
    <panel id="root" x="0" y="0" w="480" h="640" bg="#101828">
      <label id="title" x="24" y="20" w="300" h="24" text="Rich Data Demo" font="demo_20" color="#E8EFFA" />
      <label id="lbl_mode" x="24" y="64" w="200" h="18" text="Control mode (roller)" color="#8FA0BC" />
      <roller id="mode" bind="mode_idx" x="24" y="90" w="170" h="92" bg="#1A2438" on-value_changed="on_mode_change" options="Auto,Manual,Service,Bootstrap" />
      <label id="lbl_chart" x="24" y="200" w="300" h="18" text="Bus current (chart)" color="#8FA0BC" />
      <chart id="bus" kind="line" min="0" max="400" points="120" x="24" y="226" w="432" h="160" bg="#0B1220">
        <series name="Ibus" color="#5EE6C4" width="2" />
        <series name="Limit" color="#F2B84B" width="1" />
      </chart>
      <label id="lbl_tbl" x="24" y="404" w="300" h="18" text="Event log (table)" color="#8FA0BC" />
      <table id="events" cols="3" rows="5" x="24" y="430" w="432" h="150" bg="#0B1220" header="Time,Code,Message" />
      <label id="hint" x="24" y="600" w="432" h="18" text="chart/table structure: runtime C via ui_ext.h" color="#5A6A86" />
    </panel>
  </screen>
</ui>