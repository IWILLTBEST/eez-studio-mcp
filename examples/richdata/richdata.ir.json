{
 "project": {
  "name": "richdata-demo",
  "width": 480,
  "height": 640,
  "font": "demo_16"
 },
 "variables": [
  {
   "name": "mode_idx",
   "type": "integer",
   "default": 1
  },
  {
   "name": "pulse_count",
   "type": "integer",
   "default": 42
  }
 ],
 "screens": [
  {
   "name": "main",
   "children": [
    {
     "type": "panel",
     "id": "root",
     "x": 0,
     "y": 0,
     "w": 480,
     "h": 640,
     "bg": "#101828",
     "children": [
      {
       "type": "label",
       "id": "title",
       "x": 24,
       "y": 20,
       "w": 300,
       "h": 24,
       "text": "Rich Data Demo",
       "font": "demo_20",
       "color": "#E8EFFA"
      },
      {
       "type": "label",
       "id": "lbl_mode",
       "x": 24,
       "y": 64,
       "w": 200,
       "h": 18,
       "text": "Control mode (roller)",
       "color": "#8FA0BC"
      },
      {
       "type": "roller",
       "id": "mode",
       "bind": "mode_idx",
       "options": [
        "Auto",
        "Manual",
        "Service",
        "Bootstrap"
       ],
       "x": 24,
       "y": 90,
       "w": 170,
       "h": 92,
       "bg": "#1A2438",
       "events": {
        "value_changed": "on_mode_change"
       }
      },
      {
       "type": "label",
       "id": "lbl_chart",
       "x": 24,
       "y": 200,
       "w": 300,
       "h": 18,
       "text": "Bus current (chart)",
       "color": "#8FA0BC"
      },
      {
       "type": "chart",
       "id": "bus",
       "kind": "line",
       "min": 0,
       "max": 400,
       "points": 120,
       "series": [
        {
         "name": "Ibus",
         "color": "#5EE6C4",
         "width": 2
        },
        {
         "name": "Limit",
         "color": "#F2B84B",
         "width": 1
        }
       ],
       "x": 24,
       "y": 226,
       "w": 432,
       "h": 160,
       "bg": "#0B1220"
      },
      {
       "type": "label",
       "id": "lbl_tbl",
       "x": 24,
       "y": 404,
       "w": 300,
       "h": 18,
       "text": "Event log (table)",
       "color": "#8FA0BC"
      },
      {
       "type": "table",
       "id": "events",
       "cols": 3,
       "rows": 5,
       "header": [
        "Time",
        "Code",
        "Message"
       ],
       "x": 24,
       "y": 430,
       "w": 432,
       "h": 150,
       "bg": "#0B1220"
      },
      {
       "type": "label",
       "id": "hint",
       "x": 24,
       "y": 600,
       "w": 432,
       "h": 18,
       "text": "chart/table structure: runtime C via ui_ext.h",
       "color": "#5A6A86"
      }
     ]
    }
   ]
  },
  {
   "name": "controls",
   "children": [
    {
     "type": "panel",
     "id": "root2",
     "x": 0,
     "y": 0,
     "w": 480,
     "h": 640,
     "bg": "#101828",
     "children": [
      {
       "type": "label",
       "id": "title2",
       "x": 24,
       "y": 16,
       "w": 300,
       "h": 24,
       "text": "Controls Demo",
       "font": "demo_20",
       "color": "#E8EFFA"
      },
      {
       "type": "label",
       "id": "lbl_scale",
       "x": 24,
       "y": 52,
       "w": 200,
       "h": 18,
       "text": "RPM scale",
       "color": "#8FA0BC"
      },
      {
       "type": "scale",
       "id": "rpm",
       "mode": "round_inner",
       "min": 0,
       "max": 3000,
       "angle": 270,
       "rotate": 135,
       "ticks": 11,
       "major": 5,
       "sections": [
        {
         "from": 0,
         "to": 2200,
         "color": "#3A4B66",
         "width": 8
        },
        {
         "from": 2200,
         "to": 2600,
         "color": "#F2B84B",
         "width": 8
        },
        {
         "from": 2600,
         "to": 3000,
         "color": "#E5484D",
         "width": 8
        }
       ],
       "x": 24,
       "y": 74,
       "w": 180,
       "h": 180
      },
      {
       "type": "calendar",
       "id": "cal",
       "today": "2026-09-01",
       "header": "arrow",
       "x": 240,
       "y": 74,
       "w": 210,
       "h": 210
      },
      {
       "type": "label",
       "id": "lbl_count",
       "x": 24,
       "y": 286,
       "w": 200,
       "h": 18,
       "text": "Pulse count",
       "color": "#8FA0BC"
      },
      {
       "type": "spinbox",
       "id": "count",
       "bind": "pulse_count",
       "min": 0,
       "max": 9999,
       "digits": 4,
       "x": 24,
       "y": 308,
       "w": 130,
       "h": 46,
       "bg": "#1A2438"
      },
      {
       "type": "textarea",
       "id": "input",
       "text": "",
       "x": 24,
       "y": 374,
       "w": 432,
       "h": 44,
       "bg": "#0B1220"
      },
      {
       "type": "keyboard",
       "id": "kb",
       "textarea": "input",
       "mode": "number",
       "x": 24,
       "y": 426,
       "w": 432,
       "h": 190
      }
     ]
    }
   ]
  }
 ],
 "actions": [
  {
   "name": "on_mode_change",
   "steps": [
    {
     "op": "set",
     "variable": "mode_idx",
     "value": "mode_idx"
    }
   ]
  }
 ]
}