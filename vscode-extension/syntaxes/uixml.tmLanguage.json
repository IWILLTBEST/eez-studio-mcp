{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UIXML",
  "scopeName": "source.uixml",
  "patterns": [{ "include": "#misc" }],
  "repository": {
    "misc": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#procinst" },
        { "include": "#tag" }
      ]
    },
    "comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.uixml"
    },
    "procinst": {
      "begin": "(<\\?)([a-zA-Z][\\w.-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.uixml" },
        "2": { "name": "entity.name.tag.uixml" }
      },
      "end": "(\\?>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.uixml" } },
      "patterns": [{ "include": "#attr" }]
    },
    "tag": {
      "name": "meta.tag.uixml",
      "begin": "(</?)([A-Za-z][\\w.-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.uixml" },
        "2": { "name": "entity.name.tag.uixml" }
      },
      "end": "(/?>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.uixml" } },
      "patterns": [{ "include": "#attr" }]
    },
    "attr": {
      "patterns": [
        {
          "name": "meta.attribute.uixml",
          "begin": "((?:on-[a-zA-Z-]+|lv:[a-zA-Z-]+|[a-zA-Z][\\w:-]*))(=)",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.uixml" },
            "2": { "name": "keyword.operator.assignment.uixml" }
          },
          "end": "(?<=\"|')",
          "patterns": [{ "include": "#string" }]
        },
        {
          "match": "(on-[a-zA-Z-]+)",
          "name": "entity.other.attribute-name.event.uixml"
        },
        {
          "match": "(lv:[a-zA-Z-]+)",
          "name": "entity.other.attribute-name.style.uixml"
        },
        {
          "match": "[a-zA-Z][\\w:-]*",
          "name": "entity.other.attribute-name.uixml"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.uixml",
          "patterns": [
            { "match": "#[0-9A-Fa-f]{6}", "name": "constant.color.uixml" },
            { "match": "-?\\d+", "name": "constant.numeric.uixml" },
            { "match": "true|false", "name": "constant.language.uixml" }
          ]
        }
      ]
    }
  }
}
