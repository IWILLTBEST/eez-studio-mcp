{
  "comments": {
    "lineComment": null,
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<", ">"],
    ["\"", "\""]
  ],
  "autoClosingPairs": [
    { "open": "<", "close": ">", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["\"", "'"]
  ],
  "folding": {
    "markers": {
      "start": "<[^/!?][^>]*[^/]>",
      "end": "</[^>]+>"
    }
  }
}
